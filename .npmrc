# اتصال این پروژه به رجیستری npm کند است (~۷۵KB/s).
# رجیستری رسمی عمداً حفظ شده — آینه‌های شخص ثالث کمی سریع‌ترند ولی
# برای پروژه‌ای که وابستگی احراز هویت و رمزنگاری دارد ریسک زنجیرهٔ تأمین دارند.
# به‌جایش مهلت‌ها باز شده تا نصب نیمه‌کاره قطع نشود.
fetch-timeout=900000
fetch-retries=6
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=180000
audit=false
fund=false
