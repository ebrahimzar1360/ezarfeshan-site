# دامنهٔ نهایی — تا مشخص نشدن، localhost استفاده می‌شود.
# روی متادیتای سئو، canonical، sitemap و لینک‌های ایمیل اثر می‌گذارد.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# پستگرس محلی — با `npm run db init` ساخته می‌شود.
# پورت ۵۵۴۳۲ عمداً غیرپیش‌فرض است تا با هیچ نصب دیگری تداخل نکند.
#
# ⚠ `devpassword` فقط برای این کلاستر محلی است که روی localhost گوش می‌دهد.
#   روی سرور هرگز از آن استفاده نکن — در docker-compose، مقدار
#   POSTGRES_PASSWORD را از .env می‌خواند و باید تصادفی و بلند باشد.
DATABASE_URL="postgresql://ezarfeshan:devpassword@localhost:55432/ezarfeshan?schema=public"

# ایمیل — درایور console پیام را در ترمینال چاپ می‌کند و برای توسعه کافی است.
# برای smtp، دامنه لازم است: روی gmail.com نمی‌شود SPF/DKIM گذاشت و ایمیل تأیید
# به اسپم می‌رود. جزئیات در docs/OPEN-QUESTIONS.md.
MAIL_DRIVER="console"
MAIL_FROM="ابراهیم زرفشان <no-reply@localhost>"
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""

# احراز هویت ادمین — کلید امضای نشست.
# با این ساخته می‌شود: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# در پروداکشن حتماً مقدار تازه بگذار و هرگز در گیت commit نکن.
AUTH_SECRET="عوضش-کن"
